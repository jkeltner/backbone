.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Generated audio (large binary files) — match at any depth under assets/audio
episodes/*/assets/audio/**/*.mp3
episodes/*/assets/audio/**/*.wav
episodes/*/assets/audio/*.mp3
episodes/*/assets/audio/*.wav
episodes/*/assets/audio/**/per-turn/
episodes/*/final/episode.mp3
episodes/*/final/episode-wave-*.mp3
episodes/*/final/*.mp3
episodes/*/final/beta-*.mp3

# Generated video and clips (large binary files). Episode artwork in assets/images/ IS committed (~15 MB/episode) so both hosts can see it.
episodes/*/assets/video/**/*.mp4
episodes/*/assets/clips/**/*.mp4
