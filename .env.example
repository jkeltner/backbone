# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

# ---- TTS (ElevenLabs) ----
# Required to generate audio. Voice IDs come from your ElevenLabs voice library.
ELEVENLABS_API_KEY=
JEFF_VOICE_ID=
CYRUS_VOICE_ID=

# ---- Music (override defaults if swapping) ----
# Defaults are baked into tools/audio_assemble.py — only set these if changing.
# THEME_MUSIC=assets/music/backbone-theme.mp3
# TRANSITION_BUMPER=assets/music/backbone-bumper.mp3
# THEME_OUT_FADE_MS=3000

# ---- Podcast distribution (Transistor) ----
# Required to upload episodes via tools/distribute_podcast.py
TRANSISTOR_API_KEY=
TRANSISTOR_SHOW_ID=

# ---- YouTube (deferred from MVP — using Transistor's audio→video for ep 1) ----
# Re-enable if/when we use tools/distribute_youtube.py directly.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# ---- Newsletter (deferred — Buttondown) ----
# BUTTONDOWN_API_KEY=

# ---- Twitter/X (deferred) ----
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
