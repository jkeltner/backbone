# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

# ---- TTS (ElevenLabs) ----
# Required to generate audio. Voice IDs come from your ElevenLabs voice library.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3

# Each host can have a professional voice clone (PVC) and an instant voice clone (IVC).
# Tools read {SPEAKER}_VOICE_ID_{CLONE} first, then fall back to {SPEAKER}_VOICE_ID.
# VOICE_CLONE sets the default clone; override per run with --clone pvc|ivc.
VOICE_CLONE=pvc
JEFF_VOICE_ID_PVC=
JEFF_VOICE_ID_IVC=
CYRUS_VOICE_ID_PVC=
CYRUS_VOICE_ID_IVC=

# ---- Music (override defaults if swapping) ----
# Defaults are baked into tools/audio_assemble.py — only set these if changing.
# THEME_MUSIC=assets/music/backbone-theme.mp3
# TRANSITION_BUMPER=assets/music/backbone-bumper.mp3
# THEME_OUT_FADE_MS=3000

# ---- Podcast distribution (Transistor) ----
# Required to upload episodes via tools/distribute_podcast.py
TRANSISTOR_API_KEY=
TRANSISTOR_SHOW_ID=
